{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen",
  "version": "0.1.14",
  "identifier": "studio.lumen.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumen",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 http://127.0.0.1:34872 blob: asset: http://asset.localhost https://lumen-vibestarter.contact-delaplacetheo.workers.dev; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/Lumen/**",
          "$DOCUMENT/AssetsDownloader/vibestarter_assets/**",
          "$PICTURE/textures/**",
          "$HOME/OneDrive/Images/textures/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2NERFMzU5NjEwMUQ2RDUKUldUVjFnRmhXZU5OTnFYdHd4ZUlFa29RRnovSTdxbUxaZ1VnbkxFbGlnTEFVZXRIYzdaT2ZlQXEK",
      "endpoints": [
        "https://github.com/Hazeyy5/lumen-studio/releases/latest/download/latest.json"
      ]
    }
  }
}
